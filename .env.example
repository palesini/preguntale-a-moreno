# ── LLM (cualquier API compatible con OpenAI) ─────────────────────────────
# Sin LLM_API_KEY, o si el LLM falla o se pasa del cupo, la app responde en "modo archivo"
# (citas reales del corpus, sin IA, costo cero).
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4.1-mini   (no uses gpt-5*: son de razonamiento y no aceptan temperature/max_tokens)
# Groq (gratis): LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=qwen/qwen3.8-27b   (plan gratis: ~1000 pedidos/día, 8000 tokens/min)
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=anthropic/claude-haiku-4.5
# DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1       LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# LLM_TIMEOUT_MS=20000

# Pedidos por minuto por IP en /api/chat
# CHAT_RATE_LIMIT_PER_MIN=15

# ── WhatsApp (Twilio) — opcional ──────────────────────────────────────────
# TWILIO_AUTH_TOKEN=
# TWILIO_WEBHOOK_URL=https://TU_DOMINIO/api/whatsapp

# ── Telegram ──────────────────────────────────────────────────────────────
# Token de @BotFather (solo hace falta para `npm run telegram:setup`, no en Vercel)
# TELEGRAM_BOT_TOKEN=
# Secreto que Telegram manda en cada pedido (también en Vercel)
# TELEGRAM_WEBHOOK_SECRET=
# Usuario del bot sin @ (también en Vercel)
# TELEGRAM_BOT_USERNAME=ElModoMorenoBot
# URL pública del sitio (para registrar el webhook)
# SITE_URL=https://preguntaleamoreno.vercel.app
# Botón "Telegram" en la web (en Vercel, antes del build)
# NEXT_PUBLIC_TELEGRAM_URL=https://t.me/ElModoMorenoBot
